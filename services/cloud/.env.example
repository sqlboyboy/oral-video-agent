# Cloud API security
ADMIN_TOKEN=change-admin-token
WORKER_TOKEN=change-worker-token

# SQLite is the local fallback when DATABASE_URL is empty.
CLOUD_DATABASE_PATH=./data/cloud.sqlite3

# Production deployment should use PostgreSQL via DATABASE_URL.
POSTGRES_DB=oral_video_cloud
POSTGRES_USER=oral_video
POSTGRES_PASSWORD=change-postgres-password
DATABASE_URL=postgresql://oral_video:change-postgres-password@postgres:5432/oral_video_cloud
REDIS_URL=redis://redis:6379/0
CLIENT_RATE_LIMIT_PER_MINUTE=180
WORKER_RATE_LIMIT_PER_MINUTE=600

# Email login code. Use EMAIL_PROVIDER=console for local development; production
# can use Tencent Cloud SES with the credentials below.
EMAIL_PROVIDER=console
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
SES_REGION=ap-guangzhou
SES_FROM_EMAIL=noreply@example.com
SES_LOGIN_TEMPLATE_ID=52849
SES_LOGIN_SUBJECT=杰速口播邮箱验证码
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_PER_EMAIL_PER_HOUR=5
EMAIL_CODE_PER_DEVICE_PER_HOUR=10
EMAIL_CODE_PER_DEVICE_PER_DAY=30
QUEUED_JOB_TIMEOUT_SECONDS=86400

# Script rewrite provider used by /api/client/rewrite.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30

# Object storage. Use local to store temporary uploads/results on the cloud
# server disk and serve them through signed /api/storage URLs. Use cos only if
# you intentionally want Tencent COS pre-signed URLs.
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_ROOT=./data/object_storage
CLOUD_PUBLIC_BASE_URL=https://api.example.com
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_STALE_INPUT_CLEANUP_HOURS=24

# Tencent COS compatibility. Only used when OBJECT_STORAGE_BACKEND=cos.
COS_BUCKET=oral-video-agent-dev
COS_REGION=ap-guangzhou
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SCHEME=https
COS_PUBLIC_BASE_URL=
COS_MOCK_SECRET=change-cos-mock-secret
COS_UPLOAD_URL_EXPIRES_SECONDS=3600
COS_DOWNLOAD_URL_EXPIRES_SECONDS=3600
COS_CLEANUP_HOURS=72
COS_DOWNLOAD_CONFIRM_DELETE_DELAY_HOURS=0

# Optional enterprise WeChat/Feishu/DingTalk webhook.
NOTIFY_WEBHOOK_URL=
NOTIFY_COOLDOWN_SECONDS=900

# Queue notification thresholds.
NOTIFY_QUEUED_THRESHOLD=1
NOTIFY_WAIT_MINUTES_THRESHOLD=30
WORKER_STALE_SECONDS=600

# MVP license and credit rules.
MAX_DEVICES_PER_USER=1
LICENSE_ACTIVATION_GRANT_POINTS=0
BONUS_DAILY_SPEND_LIMIT=90
MAX_RENDER_DURATION_SECONDS=600
SCHEDULER_INTERVAL_SECONDS=60
RUNNING_JOB_TIMEOUT_SECONDS=7200
