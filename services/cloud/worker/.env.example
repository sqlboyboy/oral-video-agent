CLOUD_API_BASE=https://api.example.com
WORKER_TOKEN=change-worker-token
WORKER_ID=autodl-4090-1

# Poll queue when no job is available.
WORKER_POLL_SECONDS=30

# Shut down after this many idle minutes.
IDLE_SHUTDOWN_MINUTES=15

# Keep false until the worker has been tested on the real AutoDL instance.
ENABLE_AUTODL_SHUTDOWN=false
SHUTDOWN_COMMAND='sudo shutdown -h now'

# Without RENDER_COMMAND, the worker only simulates work to test queue flow.
SIMULATE_RENDER_SECONDS=20

# With RENDER_COMMAND, the worker downloads cloud input assets first, writes a
# local job JSON, runs this command, then uploads ORAL_VIDEO_OUTPUT_PATH back to
# the cloud API's temporary storage.
# Available placeholders/env vars:
#   {job_json} / ORAL_VIDEO_JOB_JSON
#   {job_id} / ORAL_VIDEO_JOB_ID
#   {output_path} / ORAL_VIDEO_OUTPUT_PATH
#   {work_dir} / ORAL_VIDEO_WORK_DIR
RENDER_COMMAND='/root/oral-video-agent-cloud-worker/run_render.sh {job_json} {output_path}'

# run_render.sh calls the local FastAPI generation backend on the AutoDL host.
LOCAL_RENDER_API_BASE=http://127.0.0.1:8000
LOCAL_RENDER_API_TIMEOUT_SECONDS=7200
