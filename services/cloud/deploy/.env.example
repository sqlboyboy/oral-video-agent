ADMIN_TOKEN=replace-with-long-random-admin-token
WORKER_TOKEN=replace-with-long-random-worker-token
CLOUD_DATABASE_PATH=/data/cloud.sqlite3

# Keep DATABASE_URL enabled in deployment so cloud-api and scheduler use PostgreSQL.
POSTGRES_DB=oral_video_cloud
POSTGRES_USER=oral_video
POSTGRES_PASSWORD=replace-with-long-random-postgres-password
DATABASE_URL=postgresql://oral_video:replace-with-long-random-postgres-password@postgres:5432/oral_video_cloud
REDIS_URL=redis://redis:6379/0
CLIENT_RATE_LIMIT_PER_MINUTE=180
WORKER_RATE_LIMIT_PER_MINUTE=600

EMAIL_PROVIDER=console
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
SES_REGION=ap-guangzhou
SES_FROM_EMAIL=
SES_LOGIN_TEMPLATE_ID=
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5

# Temporary object storage. local keeps files on this cloud server and serves
# signed upload/download URLs through /api/storage.
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_ROOT=/data/object_storage
CLOUD_PUBLIC_BASE_URL=https://api.example.com
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_STALE_INPUT_CLEANUP_HOURS=24

# Docker nginx public bind. If the host already runs nginx on port 80, set this
# to 127.0.0.1:18081 and proxy from the host nginx to cloud-api instead.
CLOUD_NGINX_BIND=80

# Tencent COS compatibility. Only used when OBJECT_STORAGE_BACKEND=cos.
COS_BUCKET=replace-with-cos-bucket
COS_REGION=ap-guangzhou
COS_SECRET_ID=replace-with-cos-secret-id
COS_SECRET_KEY=replace-with-cos-secret-key
COS_SCHEME=https
COS_PUBLIC_BASE_URL=
COS_MOCK_SECRET=replace-with-long-random-cos-mock-secret
COS_UPLOAD_URL_EXPIRES_SECONDS=3600
COS_DOWNLOAD_URL_EXPIRES_SECONDS=3600
COS_CLEANUP_HOURS=72
COS_DOWNLOAD_CONFIRM_DELETE_DELAY_HOURS=0

NOTIFY_WEBHOOK_URL=
NOTIFY_COOLDOWN_SECONDS=900
NOTIFY_QUEUED_THRESHOLD=1
NOTIFY_WAIT_MINUTES_THRESHOLD=30
WORKER_STALE_SECONDS=600

MAX_DEVICES_PER_USER=1
LICENSE_ACTIVATION_GRANT_POINTS=0
BONUS_DAILY_SPEND_LIMIT=90
MAX_RENDER_DURATION_SECONDS=600
SCHEDULER_INTERVAL_SECONDS=60
RUNNING_JOB_TIMEOUT_SECONDS=7200
