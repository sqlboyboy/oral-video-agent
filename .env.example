# API
API_HOST=127.0.0.1
API_PORT=8000

# LLM rewrite provider (remote API only)
REWRITE_PROVIDER=deepseek
# Fill your DeepSeek API key here.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=120

# ASR provider
ASR_PROVIDER=placeholder
WHISPER_MODEL=small

# Voice/TTS provider
VOICE_PROVIDER=remote-cosyvoice
VOICE_BASE_URL=http://127.0.0.1:16010
VOICE_TIMEOUT_SECONDS=1800
TTS_API_KEY=

# Digital human: upload a silent/non-speaking real-person video,
# then let HeyGem generate mouth motion from the cloned voice.
DIGITAL_HUMAN_PROVIDER=heygem-local
# Local end of the SSH tunnel to the AutoDL HeyGem API.
HEYGEM_BASE_URL=http://127.0.0.1:16008
HEYGEM_TIMEOUT_SECONDS=3600
# Optional but recommended for AutoDL: transfer large media with SCP and call
# HeyGem's local-path queue endpoint, avoiding gateway HTTP idle timeouts.
HEYGEM_SSH_HOST=
HEYGEM_SSH_PORT=22
HEYGEM_SSH_USER=root
HEYGEM_SSH_KEY_PATH=
HEYGEM_REMOTE_UPLOAD_DIR=/root/autodl-tmp/oral-video-agent-inputs

# Douyin cookie file (needed for link import)
# 1. Install "Get cookies.txt LOCALLY" extension in Edge/Chrome
# 2. Visit douyin.com (login not required, just visit the page)
# 3. Export cookies and save to storage/douyin_cookies.txt
# 4. Set the path below
DOUYIN_COOKIES_FILE=storage/douyin_cookies.txt

# FFmpeg
FFMPEG_PATH=ffmpeg
