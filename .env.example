# API
API_HOST=127.0.0.1
API_PORT=8000

# LLM rewrite provider
REWRITE_PROVIDER=placeholder
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6

# ASR provider
ASR_PROVIDER=placeholder
WHISPER_MODEL=small

# Voice/TTS provider
VOICE_PROVIDER=placeholder
TTS_API_KEY=

# Digital human / lip-sync provider
DIGITAL_HUMAN_PROVIDER=wav2lip-onnx
WAV2LIP_ONNX_MODEL=storage/models/wav2lip/wav2lip.onnx
# Enables the commercial-style "only replace the mouth" blend after Wav2Lip.
WAV2LIP_BLEND_ENABLED=true
# balanced keeps mouth opening; natural adds softer edges; detail adds local texture restore.
WAV2LIP_BLEND_PRESET=balanced
# Optional same-identity video for closed/micro-open stability.
# Leave empty to reuse the selected digital-human reference when STRENGTH > 0.
WAV2LIP_APERTURE_ATLAS_SOURCE=
WAV2LIP_APERTURE_ATLAS_STRENGTH=0.5
WAV2LIP_APERTURE_ENERGY_THRESHOLD=0.24
WAV2LIP_APERTURE_MIN_RATIO=0.07
WAV2LIP_APERTURE_MAX_RATIO=0.36
WAV2LIP_APERTURE_ATTACK=1.0
WAV2LIP_APERTURE_RELEASE=1.0
# Internal post-render QA. Writes sidecar diagnostics; diagnosis failure does not block output.
WAV2LIP_QUALITY_DIAGNOSTICS_ENABLED=true
WAV2LIP_QUALITY_DIAGNOSTICS_SAMPLE_STRIDE=2
WAV2LIP_QUALITY_DIAGNOSTICS_MAX_FRAMES=240

# Douyin cookie file (needed for link import)
# 1. Install "Get cookies.txt LOCALLY" extension in Edge/Chrome
# 2. Visit douyin.com (login not required, just visit the page)
# 3. Export cookies and save to storage/douyin_cookies.txt
# 4. Set the path below
DOUYIN_COOKIES_FILE=storage/douyin_cookies.txt

# FFmpeg
FFMPEG_PATH=ffmpeg
